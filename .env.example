# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Supabase Dashboard → Project Settings → API).
#
# `.env.local` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL. Used by browser + server. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Used by browser + server. Safe to expose —
# Row Level Security protects your data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key. *** SERVER-ONLY. Bypasses RLS. ***
# Used server-side to insert enquiries and for admin medicine writes/uploads.
#   - No NEXT_PUBLIC_ prefix on purpose, so it is never bundled for the browser.
#   - Only lib/supabase/admin.ts reads it (guarded by `import "server-only"`).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------------
# OPTIONAL — email notifications for new enquiries (via Resend).
# If these are omitted, enquiries still save and show in the admin inbox;
# email is simply skipped. Get a key at https://resend.com.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# ENQUIRY_NOTIFY_EMAIL=you@your-company.com
# ENQUIRY_FROM_EMAIL=Meridian <notifications@your-verified-domain.com>
